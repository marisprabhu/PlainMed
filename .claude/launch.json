{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "plainmed",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app/streamlit_app.py"
      ],
      "port": 8501
    },
    {
      "name": "plainmed-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "plainmed.api.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "src"
      ],
      "port": 8000
    }
  ]
}
